              "@hau/features/documents/*", "@hau/features/documents/**",
              "@hau/features/main/*", "@hau/features/main/**",
              "@hau/features/maintenance/*", "@hau/features/maintenance/**",
              "@hau/features/reports/*", "@hau/features/reports/**"
            ],
            "message": "A feature must not import another feature directly — see docs/architecture-audit.md. Route cross-feature wiring through the composition root (features/main/main.routes.ts) instead."
          }]
