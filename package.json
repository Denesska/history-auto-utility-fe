{
  "name": "history-auto-utility",
  "version": "0.3.5",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "generate-firebase-sw": "node scripts/generate-firebase-sw.js",
    "prestart": "npm run generate-firebase-sw",
    "start": "ng serve",
    "prestart:local": "npm run generate-firebase-sw",
    "start:local": "ng serve --configuration local",
    "prestart:dev": "npm run generate-firebase-sw",
    "start:dev": "ng serve --configuration development",
    "prestart:proxy": "npm run generate-firebase-sw",
    "start:proxy": "ng serve --configuration proxy",
    "prestart:denhau": "npm run generate-firebase-sw",
    "start:denhau": "ng serve --host 0.0.0.0 --port 4200 --disable-host-check",
    "prebuild": "npm run generate-firebase-sw",
    "build": "ng build",
    "prebuild:test": "npm run generate-firebase-sw",
    "build:test": "ng build --configuration test",
    "api-gen": "ng-openapi-gen --input api-backend.yaml --output src/auto-gen/api",
    "generate-api": "openapi-generator-cli generate -i ../history-auto-utility-be/prisma/swagger.yaml -g typescript-angular -o src/auto-gen --additional-properties=providedInRoot=true,ngVersion=21.0,useRxJS6=true",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "assets:prepare": "node -e \"require('fs').copyFileSync('src/assets/icon/favicon.svg','assets/icon.svg')\"",
    "assets:android": "npm run assets:prepare && capacitor-assets generate --android --iconBackgroundColor \"#FF9A2E\"",
    "assets:android:dev": "npm run assets:prepare && capacitor-assets generate --android --iconBackgroundColor \"#D32F2F\"",
    "assets:android:test": "npm run assets:prepare && capacitor-assets generate --android --iconBackgroundColor \"#2E7D32\"",
    "android:check-firebase": "node -e \"if (!require('fs').existsSync('android/app/google-services.json')) { console.error('Missing android/app/google-services.json; Android push notifications would crash at runtime.'); process.exit(1); }\"",
    "prebuild:android:apk": "npm run generate-firebase-sw && npm run android:check-firebase",
    "build:android:apk": "npm run assets:android:dev && ng build --configuration development && cap sync android && cd android && gradlew.bat assembleDebug && cd .. && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-android-apk.ps1 -Environment dev",
    "prebuild:android:apk:test": "npm run generate-firebase-sw && npm run android:check-firebase",
    "build:android:apk:test": "npm run assets:android:test && ng build --configuration test && set CAP_WEB_DIR=www-test&& cap sync android && cd android && gradlew.bat assembleDebug && cd .. && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-android-apk.ps1 -Environment test",
    "prebuild:android:apk:prod": "npm run generate-firebase-sw && npm run android:check-firebase",
    "build:android:apk:prod": "npm run assets:android && ng build --configuration production && cap sync android && cd android && gradlew.bat assembleDebug && cd .. && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-android-apk.ps1 -Environment prod",
    "build:android:pilot": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-pilot.ps1",
    "setup:android:pilot-signing": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/set-android-pilot-signing-password.ps1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@auth0/angular-jwt": "^5.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^9.0.5",
    "@jsverse/transloco": "^8.4.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngxs/logger-plugin": "^22.0.0",
    "@ngxs/store": "^22.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "angular-oauth2-oidc": "^22.0.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "embla-carousel": "^8.6.0",
    "firebase": "^12.19.0",
    "ionicons": "^8.1.0",
    "ng-openapi-gen": "^1.1.0",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.4",
    "swiper": "^14.2.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular-devkit/schematics": "^22.2.0",
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/language-service": "^22.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/eslintrc": "^3.3.7",
    "@ionic/angular-toolkit": "^13.0.0",
    "@schematics/angular": "^22.2.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^7.0.2",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "description": "HAU (History Auto Utility)",
  "allowScripts": {
    "sharp@0.32.6": true,
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.6": true
  }
}
